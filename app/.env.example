# Kamp.la — Ortam Değişkenleri Şablonu
# Kopyala: cp .env.example .env  (kök dizinde, apps/mobile-web ve apps/admin bu dosyayı
# monorepo kökünden okuyacak şekilde birlikte çalıştırılır)
# Gerçek değerleri buraya GİRME — bu dosya .env.example, yalnızca placeholder içerir.
# Detaylı açıklamalar için bkz. Kurulum-Gereksinimleri.md

# ── 🔴 Faz 0–1: Supabase ──────────────────────────────────────────────
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Gizli — yalnızca sunucu/admin tarafında kullanılır, ASLA istemciye/repoya expose edilmez.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── 🟠 Faz 2: Harita (MapTiler) ───────────────────────────────────────
NUXT_PUBLIC_MAPTILER_KEY=your-maptiler-api-key

# ── 🟠 Faz 4: Medya Depolama (Cloudflare R2) ──────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=kampla-media
NUXT_PUBLIC_R2_PUBLIC_URL=https://media.kamp.la

# ── 🟡 Faz 9: Ödeme / Abonelik (RevenueCat) ───────────────────────────
NUXT_PUBLIC_REVENUECAT_IOS_API_KEY=your-revenuecat-ios-key
NUXT_PUBLIC_REVENUECAT_ANDROID_API_KEY=your-revenuecat-android-key
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret

# ── 🟡 Faz 12: Rota Motoru (Valhalla/OSRM, self-hosted) ───────────────
NUXT_PUBLIC_ROUTING_API_URL=https://routing.kamp.la
