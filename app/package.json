{
  "name": "kampla",
  "private": true,
  "version": "0.1.0",
  "description": "Kamp.la — kamp/karavan keşif uygulaması monorepo (Faz 0 iskelet)",
  "packageManager": "pnpm@9.15.9",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "pnpm --filter kampla-mobile-web dev",
    "dev:admin": "pnpm --filter kampla-admin dev",
    "build": "pnpm --filter kampla-mobile-web build",
    "build:admin": "pnpm --filter kampla-admin build",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
